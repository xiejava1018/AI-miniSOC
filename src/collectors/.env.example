# ─── 通用 ───
MINISOC_URL=http://host.docker.internal:8000
MINISOC_API_KEY=sk-minisoc-xxxxx

# ─── TP-Link Collector ───
ROUTER_HOST=192.168.0.1
ROUTER_USERNAME=tploginadmin
ROUTER_PASSWORD=your-router-password
TPLINK_INTERVAL=300

# ─── Scanner Collector（P3 资产发现与攻击面扫描）──
# 公网扫描目标 IP/CIDR，逗号分隔；留空则扫不了
SCAN_PUBLIC_TARGETS=203.0.113.10
SCANNER_NMAP_TIMEOUT=300
SCANNER_MAX_RATE=100
SCANNER_LOG_LEVEL=INFO


# ── ARL-Next 集成（OH-ARL.1，可选启用）──
# 启用：填入凭据 + 设 COMPOSE_PROFILES=arl（docker compose 原生 profile，
#       默认不含 arl-collector——凭据缺失时该容器启动即崩，见 compose 注释）
ARL_BASE_URL=https://192.168.0.42:5173
ARL_API_KEY=                        # 或 ARL_USERNAME+ARL_PASSWORD（login 换 token，会话 24h）
ARL_USERNAME=
ARL_PASSWORD=
ARL_SCOPE_IDS=                      # 逗号分隔 scope_id；留空 = 全部资产组
ARL_VERIFY_TLS=false
ARL_SYNC_INTERVAL_S=1800
COMPOSE_PROFILES=
