# ============================================
# AI-miniSOC 环境变量配置模板
# 使用方法: cp .env.example .env 然后填入实际值
# 注意: .env 文件已加入 .gitignore，不会被提交
#
# 配置分层约定:
#   - 本文件仅承载「安装期配置」(数据库连接、密钥种子、服务端口) 与「进程级开关」
#   - 业务策略类配置 (阈值/规则/对接参数) 请走 系统管理 → 系统配置 (soc_system_config)
#     该表支持界面修改、60 秒内生效，无需重启服务
#   - 本文件中列出的键名必须与 app/core/config.py 的 Settings 字段完全一致，
#     键名写错不会报错、只会静默回落默认值 (曾发生 LOKI_URL / LOKI_API_URL 事故)
# ============================================

# ---------- 数据库 (必填) ----------
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# 独立测试库，与 DB_NAME 完全隔离。跑 pytest 前需先：CREATE DATABASE "<TEST_DB_NAME>";
TEST_DB_NAME=AI-miniSOC-db_test

# ---------- 密钥种子 (必填，首次生成后不可更改) ----------
# 用于 JWT 签名，改动会导致所有已签发 token 立即失效
SECRET_KEY=
# 用于敏感配置加密 (Fernet)，改动会导致已加密数据无法解密
# 生成方式: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ---------- JWT 与登录安全 (可选，均有默认值) ----------
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=AI-miniSOC
JWT_AUDIENCE=AI-miniSOC-Client
# 连续登录失败 N 次后自动锁定账户
ACCESS_TOKEN_ATTEMPT_LIMIT=5
# 失败计数窗口（分钟），超过该时间未持续失败则自动重置
ACCESS_TOKEN_LOCKOUT_MINUTES=30

# ---------- 后端服务 (可选) ----------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# 逗号分隔，前端访问地址
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Wazuh 对接 ----------
WAZUH_API_URL=https://192.168.0.40:55000
# 必填
WAZUH_API_USERNAME=
WAZUH_API_PASSWORD=

# ---------- OpenSearch (Wazuh Indexer) ----------
OPENSEARCH_URL=https://192.168.0.40:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=

# ---------- Loki ----------
# 注意键名是 LOKI_API_URL，写成 LOKI_URL 不会生效
LOKI_API_URL=http://192.168.0.30:3100

# ---------- AI 服务 - 智谱 GLM (必填) ----------
GLM_API_KEY=
GLM_MODEL=glm-4-flash
GLM_API_BASE=https://open.bigmodel.cn/api/paas/v4/

# ---------- Wazuh Webhook ----------
# 生产环境务必修改
WAZUH_WEBHOOK_KEY=change-this-in-production
# 允许调用 Webhook 的来源 IP，逗号分隔
WAZUH_WEBHOOK_ALLOWED_IPS=127.0.0.1

# ---------- 采集器 API Key (逗号分隔，每个 Collector 一个) ----------
COLLECTOR_API_KEYS=

# ---------- 进程级调度开关 ----------
# 上网行为异常检测总开关 (具体阈值在 soc_system_config 的 browsing_detection 分类下)
BROWSING_DETECT_ENABLED=true
# 每日告警治理摘要生成（整点小时 0-23）
ALERT_DIGEST_SCHEDULER_ENABLED=true
ALERT_DIGEST_SCHEDULER_HOUR=8
# CISA KEV 在野利用情报同步（24 小时一次）
CISA_KEV_SCHEDULER_ENABLED=true
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
# AI 主动推送巡检（最小 5 分钟）
PUSH_SCHEDULER_ENABLED=true
PUSH_SCHEDULER_INTERVAL_MINUTES=30

# ---------- Claude Code CLI (可选，通过本地 claude 子进程调用) ----------
CLAUDE_CLI_PATH=claude
CLAUDE_CLI_MODEL=sonnet
CLAUDE_CLI_TIMEOUT=300
CLAUDE_CLI_WORKSPACE=
CLAUDE_CLI_EFFORT=medium
CLAUDE_CLI_ALLOWED_TOOLS=
# 仅在隔离环境开启
CLAUDE_CLI_DANGEROUSLY_SKIP=false
CLAUDE_CLI_NO_PERSIST=true

# ---------- 日志 ----------
LOG_LEVEL=INFO

# ---------- 容器级变量 (非 Settings 字段，但被容器/子进程消费) ----------
TZ=Asia/Shanghai
# 透传给 Pi Agent Node 子进程 (src/agent-runner/src/pi-agent-runner.js)
AGNES_API_KEY=
AGNES_MODEL=agnes/agnes-2.0-flash

# ============================================
# 已移除的配置项 (2026-09-11 清理)
#   以下项曾存在于 .env，但代码中无任何消费方，属"看起来能配、实际无效"的幽灵配置。
#   通知渠道 (邮件/钉钉/企业微信) 与数据保留策略将在后续版本中作为正式功能实现，
#   届时改由 soc_system_config 承载，不再写入本文件。
#   - SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASS / SMTP_FROM
#   - DINGTALK_WEBHOOK / DINGTALK_SECRET / WECHAT_WEBHOOK
#   - ALERT_EMAIL_ENABLED / ALERT_DINGTALK_ENABLED / ALERT_WECHAT_ENABLED
#   - REDIS_HOST / REDIS_PORT / REDIS_PASSWORD
#   - GRAFANA_URL / GRAFANA_ADMIN_PASSWORD
#   - DATA_RETENTION_DAYS / BACKUP_RETENTION_DAYS / LOKI_RETENTION_DAYS
#   - MAX_LOG_ENTRIES / QUERY_TIMEOUT / BATCH_SIZE / FRONTEND_PORT
# ============================================
