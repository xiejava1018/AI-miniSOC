# 环境配置
.env
.env.local
.env.*

# 项目本地记忆（不入库）
.workbuddy/

# npm/pnpm 个人镜像配置（不入库，每个开发者自配）
.npmrc

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
# 前端旁路构建的中间目录（deploy.sh build_frontend 用）。
# 不忽略的话，build 失败残留会让 `git status --porcelain` 非空，
# 重演部署 #61 的 uncommitted 门禁卡死
dist.new/
dist.old/
dist.prev/
build/
venv/
env/
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
# macOS AppleDouble 资源分支：从 Mac 经 tar/scp 中转文件到服务器时会成对生成 ._xxx，
# 未忽略会污染 git status --porcelain，卡死 deploy.sh 的 uncommitted 门禁（部署 #61 事故）
._*

# Logs
*.log

# 备份文件
*.backup
*.bak
*~
*.local

# 敏感文件 - 安全原则：绝不提交用户名、密码、Token等凭证信息！
# SEURITY WARNING: Never commit credentials (usernames, passwords, tokens, API keys)
# 所有敏感配置必须使用环境变量或密钥管理系统
# All sensitive config must use environment variables or secret management systems

# 工作日志 - 绝不提交到git或github
work_logs/

# Git工作树 - 隔离开发空间
.worktrees/

# 开发日志中的敏感信息（旧路径，保留以防万一）
docs/development-log-*.md

# E2E Test Results
test-results/
playwright-report/

# 数据库备份 - 包含敏感数据，绝不提交
# Database backups contain production data — never commit
dbbackup/
src/backend/backups/
**/backups/
# 数据 dump 文件（任意后缀与位置）
*.dump
*.pgdump
# 一次性迁移 / 备份脚本
**/migrations_backup_*.sql
**/migration_backup_*.sql
# schema-only 备份允许入库（约定路径）
!src/backend/migrations/postgresql/*.sql
!scripts/database/*.sql

# 临时截图文件
*.png
*.jpg
*.jpeg

# 例外：允许图片资源目录的PNG文件被跟踪
!src/assets/images/**/*.png
!src/frontend/src/assets/images/**/*.png

# 上述白名单的窄例外：本地未提交的孤儿资源
# （不在远端 master，由本地其它来源引入，避免被白名单重新放行）
src/frontend/src/assets/images/ceremony/xc.png
src/frontend/src/assets/images/safeguard/

# Playwright MCP 临时文件
.playwright-mcp/

# Claude Code / IDE 工具本地数据
.auto-insight/
.claude/

# 本地 ECC 工具副本（用户在 ~/.claude/skills 也有，不要污染项目仓库）
scripts/harness-audit.js

# 运行日志（含客户端 IP 等敏感信息）
nohup.out

# MCP 配置文件（可能含 token 等凭证）
.mcp.json

# Task Master AI 任务管理状态
.taskmaster/

# 临时调试文件
diagnose-assets.html

# 路径错误的孤儿目录（src/backend/src/backend/）
src/backend/src/backend/

# === 一次性事故处理快照（不入库）===
.git-backup-pre-dump-cleanup/
.git-state-snapshot/
# 本次（2026-08-28）README 脱敏前的原始备份，仅本地留存
.docs-backup-pre-redaction/
