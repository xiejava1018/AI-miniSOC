# AI-miniSOC 环境变量配置
#
# ⚠️ 本文件是公开示例（仓库中可访问）。
# 生产环境请复制为 .env 并填入真实值，绝不要把真实凭证提交到仓库。
#
# 占位符约定：
#   <...>  =  按部署环境替换的占位符（如 <loki-host>、<your-domain>）
#   your_* =  字符串形式的占位说明，必须替换为真实值

# ===== 日志聚合（Loki）=====
LOKI_URL=http://<loki-host>:<port>
LOKI_RETENTION_DAYS=7

# ===== Wazuh SIEM =====
WAZUH_API_URL=https://<wazuh-host>:<port>
WAZUH_API_USERNAME=your_wazuh_username
WAZUH_API_PASSWORD=your_wazuh_password
WAZUH_DASHBOARD_URL=https://<wazuh-dashboard-host>:<port>

# ===== OpenSearch =====
OPENSEARCH_URL=https://<opensearch-host>:<port>
OPENSEARCH_USER=your_opensearch_user
OPENSEARCH_PASSWORD=your_opensearch_password

# ===== Grafana =====
GRAFANA_URL=http://<grafana-host>:<port>
GRAFANA_ADMIN_PASSWORD=your_grafana_admin_password

# ===== AI 服务（智谱 GLM）=====
GLM_API_KEY=your_glm_api_key_here
GLM_MODEL=glm-4-flash
GLM_API_BASE=https://open.bigmodel.cn/api/paas/v4/

# ===== 邮件通知 =====
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
SMTP_FROM=noreply@aisoc.local

# ===== 钉钉通知 =====
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=your_token
DINGTALK_SECRET=your_secret_here

# ===== 微信通知 =====
WECHAT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_key

# ===== 数据库（PostgreSQL）=====
DB_HOST=localhost             # 本地开发用 localhost；生产改为 <production-db-host>
DB_PORT=5432
DB_NAME=AI-miniSOC-db         # 生产库名（与 testdb / db_test 严格分离）
DB_USER=your_db_user
DB_PASSWORD=your_db_password_here
# 独立测试库，与 DB_NAME 完全隔离。跑 pytest 前需先：
#   CREATE DATABASE "AI-miniSOC-db_test";
TEST_DB_NAME=AI-miniSOC-db_test

# ===== JWT 认证 =====
# 键名必须与 app.core.config.Settings 字段 1:1 对应
SECRET_KEY=your_jwt_secret_key_here_change_this_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=AI-miniSOC
JWT_AUDIENCE=AI-miniSOC-Client
# 登录失败计数：连续错误 N 次后自动将账户置为 LOCKED（HTTP 403）
ACCESS_TOKEN_ATTEMPT_LIMIT=5
# 上述计数窗口（分钟），超过此时间未持续失败则自动重置
ACCESS_TOKEN_LOCKOUT_MINUTES=30

# ===== 后端 API =====
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# CORS 来源：逗号分隔，本地开发通常只需 localhost
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3006

# ===== 前端 =====
FRONTEND_PORT=5173

# ===== 日志 / 时区 =====
LOG_LEVEL=info
TZ=Asia/Shanghai

# ===== 告警通知开关 =====
ALERT_EMAIL_ENABLED=true
ALERT_DINGTALK_ENABLED=true
ALERT_WECHAT_ENABLED=false

# ===== 数据保留 =====
DATA_RETENTION_DAYS=30
BACKUP_RETENTION_DAYS=90

# ===== 性能 =====
MAX_LOG_ENTRIES=10000
QUERY_TIMEOUT=300
BATCH_SIZE=1000