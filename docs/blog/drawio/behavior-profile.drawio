<mxfile host="app.diagrams.net" version="24.7.7"><diagram id="behavior-profile" name="behavior-profile"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="880"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="行为画像 · 快照管道与五层画像" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=22;fontColor=#0f172a;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="32" y="20" width="1216" height="34" as="geometry"/></mxCell><mxCell id="st" value="每日 02:00 水位回溯式快照：逐条日志聚合 → 三层分类 → 滚动 7 天打标签 → 快照表；查询层产出 L1 群体概览与 L2 单 IP 五层画像" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#64748b;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="32" y="54" width="1216" height="24" as="geometry"/></mxCell><mxCell id="st0" value="&lt;b&gt;主体发现&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;color:#64748b&quot;&gt;discover_targets&lt;/font&gt;&lt;hr&gt;近 7 天有行为 IP&lt;br&gt;∪ 内网资产&lt;br&gt;实测 73 个主体" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#5eead4;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="48" y="116" width="184" height="130" as="geometry"/></mxCell><mxCell id="st1" value="&lt;b&gt;按日拉取&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;color:#64748b&quot;&gt;fetch_day_events&lt;/font&gt;&lt;hr&gt;Loki 逐条时间戳计数&lt;br&gt;（禁 count_over_time&lt;br&gt;防步长失真）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#5eead4;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="246" y="116" width="184" height="130" as="geometry"/></mxCell><mxCell id="st2" value="&lt;b&gt;单日聚合&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;color:#64748b&quot;&gt;aggregate_day&lt;/font&gt;&lt;hr&gt;by_hour[24] · wd_hour[7×24]&lt;br&gt;by_block[7] · domain_visits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#93c5fd;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="444" y="116" width="184" height="130" as="geometry"/></mxCell><mxCell id="st3" value="&lt;b&gt;域名分类&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;color:#64748b&quot;&gt;classify&lt;/font&gt;&lt;hr&gt;14 类兴趣&lt;br&gt;× ACT/SYS/AD 三层&lt;br&gt;词典 5 分钟热更新" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#c4b5fd;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="642" y="116" width="184" height="130" as="geometry"/></mxCell><mxCell id="st4" value="&lt;b&gt;滚动合并&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;color:#64748b&quot;&gt;merge_days(7)&lt;/font&gt;&lt;hr&gt;cat_share / top_domains&lt;br&gt;标签基于近 7 天口径" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#93c5fd;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="840" y="116" width="184" height="130" as="geometry"/></mxCell><mxCell id="st5" value="&lt;b&gt;标签+置信度&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;color:#64748b&quot;&gt;build_tags / confidence&lt;/font&gt;&lt;hr&gt;17 条规则带证据&lt;br&gt;数据量+截断惩罚 0–100" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#c4b5fd;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1038" y="116" width="184" height="130" as="geometry"/></mxCell><mxCell id="es0" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#2563eb;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=PingFang SC;fontSize=11.5;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="st0" target="st1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="es1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#2563eb;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=PingFang SC;fontSize=11.5;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="st1" target="st2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="es2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#2563eb;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=PingFang SC;fontSize=11.5;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="st2" target="st3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="es3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#2563eb;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=PingFang SC;fontSize=11.5;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="st3" target="st4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="es4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#2563eb;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=PingFang SC;fontSize=11.5;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="st4" target="st5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="snap" value="&lt;b&gt;快照落库（幂等 upsert · 先删后插）&lt;/b&gt;&lt;br&gt;soc_behavior_profiles：分布 + 标签 + traffic_type + confidence（status: ok / gap）&lt;br&gt;soc_behavior_domains：每日 TOP 200 域名明细（可下钻单域名逐日曲线）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#fcd34d;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12.5;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="48" y="296" width="560" height="96" as="geometry"/></mxCell><mxCell id="e_snap" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#94a3b8;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=PingFang SC;fontSize=11.5;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="st5" target="snap"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="mach" value="&lt;b&gt;人 / 机器 / 混合判定&lt;/b&gt;&lt;br&gt;SYS 层占比 ≥ 50% → machine&lt;br&gt;辅助：TOP3 域名集中度 ≥ 50%&lt;br&gt;+ 24h 曲线变异系数 ≤ 0.15" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c4b5fd;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="648" y="296" width="276" height="96" as="geometry"/></mxCell><mxCell id="wm" value="&lt;b&gt;水位回溯与防假绿&lt;/b&gt;&lt;br&gt;last_completed_date 补缺口（≤8 天/轮）&lt;br&gt;超出 Loki 7 天窗口 → gap 占位&lt;br&gt;180 天留存自动清理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5eead4;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="952" y="296" width="280" height="96" as="geometry"/></mxCell><mxCell id="e_mach" value="layer_visit" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#7c3aed;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=PingFang SC;fontSize=11.5;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="st3" target="mach"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l2c" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#a5b4fc;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="48" y="440" width="688" height="396" as="geometry"/></mxCell><mxCell id="l2ct" value="&lt;b&gt;L2 · 单 IP 画像详情（/browsing/profile/detail/:ip）&lt;/b&gt;&lt;br&gt;左栏身份档案卡固定 · 右栏四个 Tab" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13.5;fontColor=#0f172a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="64" y="450" width="500" height="40" as="geometry"/></mxCell><mxCell id="ly0" value="&lt;b&gt;层 1 · 身份档案&lt;/b&gt;　IP/MAC/主机名/OS/责任人&lt;br&gt;关联账号（身份管道）&lt;br&gt;设备共享度 · 数据新鲜度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a5b4fc;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=11.5;fontColor=#0f172a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="64" y="496" width="656" height="56" as="geometry"/></mxCell><mxCell id="ly1" value="&lt;b&gt;层 2 · 行为画像&lt;/b&gt;　标签卡置顶 → 24h 曲线 →&lt;br&gt;7 时段 → 星期×小时热力 →&lt;br&gt;分类×时段 → 域名 TOP 20" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a5b4fc;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=11.5;fontColor=#0f172a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="64" y="560" width="656" height="56" as="geometry"/></mxCell><mxCell id="ly2" value="&lt;b&gt;层 3 · 风险画像&lt;/b&gt;　告警分级/规则榜（AI 去噪）&lt;br&gt;漏洞 KEV 在野利用&lt;br&gt;危险端口 22/5901 · 评分趋势" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a5b4fc;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=11.5;fontColor=#0f172a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="64" y="624" width="656" height="56" as="geometry"/></mxCell><mxCell id="ly3" value="&lt;b&gt;层 4 · 关系画像&lt;/b&gt;　ECharts 力导向拓扑&lt;br&gt;出站绿/入站蓝/外部攻击红&lt;br&gt;点节点钻取对方画像" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a5b4fc;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=11.5;fontColor=#0f172a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="64" y="688" width="656" height="56" as="geometry"/></mxCell><mxCell id="ly4" value="&lt;b&gt;层 5 · 异常判定&lt;/b&gt;　访问量 5 倍激增 · 节律突变&lt;br&gt;机器流量 · 数据截断/缺失&lt;br&gt;信号+证据，人工复核定性" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a5b4fc;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=11.5;fontColor=#0f172a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="64" y="752" width="656" height="56" as="geometry"/></mxCell><mxCell id="l1c" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf2f8;strokeColor=#f9a8d4;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="776" y="440" width="456" height="240" as="geometry"/></mxCell><mxCell id="l1ct" value="&lt;b&gt;L1 · 行为画像群体概览（/browsing/profile）&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0f172a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="792" y="450" width="420" height="20" as="geometry"/></mxCell><mxCell id="l1a" value="· 群体 KPI：主体数 / 人类 / 机器 / 数据完整度&lt;br&gt;· 人设分布：夜猫子 29 · 间歇上线 21 · 作息规律 20…&lt;br&gt;· 全网活跃节律（24h 曲线 + 时段占比）&lt;br&gt;· 全网兴趣构成：AI 工具 19.5% · 电商 15.2%…&lt;br&gt;· 风险分层 + 画像主体列表（筛选排序）&lt;br&gt;· 双 IP 余弦相似度对比 · 多日趋势 · MCP 工具" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f9a8d4;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=11.5;fontColor=#0f172a;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="792" y="478" width="424" height="190" as="geometry"/></mxCell><mxCell id="entr" value="&lt;b&gt;三个入口三级联动&lt;/b&gt;&lt;br&gt;资产列表点 IP · 告警详情点 agent_ip&lt;br&gt;行为基线点 IP → 直达画像详情&lt;br&gt;&lt;br&gt;&lt;b&gt;合规约束&lt;/b&gt;&lt;br&gt;画像仅输出信号不定性，定性须人工复核&lt;br&gt;明细 ≥ 180 天自动清理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=11.5;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="776" y="704" width="456" height="132" as="geometry"/></mxCell><mxCell id="e_l2a" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#94a3b8;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=PingFang SC;fontSize=11.5;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="snap" target="l2c"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_l1a" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#94a3b8;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=PingFang SC;fontSize=11.5;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="snap" target="l1c"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>