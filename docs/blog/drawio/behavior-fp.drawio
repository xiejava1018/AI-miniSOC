<mxfile host="app.diagrams.net" version="24.7.7"><diagram id="behavior-fp" name="behavior-fp"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="820"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="误报治理 · 从「2353 条没人看」到「12 条值得看」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=22;fontColor=#0f172a;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="32" y="20" width="1216" height="34" as="geometry"/></mxCell><mxCell id="st" value="上线 32 天的 0 处置 0 升级 0 通知 → 根因定位 → 三个配置项止血（1 小时）→ 告警量 -84%、有效率翻 4 倍" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#64748b;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="32" y="54" width="1216" height="24" as="geometry"/></mxCell><mxCell id="bad" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#fca5a5;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="48" y="112" width="372" height="420" as="geometry"/></mxCell><mxCell id="badt" value="&lt;b&gt;改造前 · 上线 32 天实测&lt;/b&gt;&lt;br&gt;（2026-08-03 ~ 09-04）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0f172a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="64" y="122" width="340" height="40" as="geometry"/></mxCell><mxCell id="bad1" value="2353 条告警 → &lt;b&gt;0 处置 · 0 升级 · 0 通知&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fca5a5;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12.5;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="64" y="172" width="340" height="44" as="geometry"/></mxCell><mxCell id="bad2" value="&lt;b&gt;96.9% 恰好 50 分&lt;/b&gt;&lt;br&gt;R4(35) + R5(15) = 50 正好压线&lt;br&gt;严重度分层实际退化为二元" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fca5a5;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="64" y="228" width="340" height="64" as="geometry"/></mxCell><mxCell id="bad3" value="&lt;b&gt;83% 告警来自 R4 误判 STUN&lt;/b&gt;&lt;br&gt;stun.miwifi.com（小米）· bilibili&lt;br&gt;stun.hitv.com（海信电视）…&lt;br&gt;均为 WebRTC/P2P 正常流量" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fca5a5;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="64" y="304" width="340" height="92" as="geometry"/></mxCell><mxCell id="bad4" value="&lt;b&gt;有效告警率仅 ~12%&lt;/b&gt;&lt;br&gt;真实可疑只有 stun.225284.xyz&lt;br&gt;等随机数字域名" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fca5a5;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="64" y="408" width="340" height="64" as="geometry"/></mxCell><mxCell id="bad5" value="基线只增不减：7 天语义 → 5 分钟" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fca5a5;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="64" y="482" width="340" height="36" as="geometry"/></mxCell><mxCell id="why" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#fcd34d;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="452" y="112" width="340" height="420" as="geometry"/></mxCell><mxCell id="whyt" value="&lt;b&gt;根因链（因果闭环死亡）&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0f172a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="468" y="122" width="308" height="40" as="geometry"/></mxCell><mxCell id="why0" value="R4 把 STUN 当隧道工具&lt;br&gt;&lt;b&gt;关键词语义误判&lt;/b&gt;（设计缺陷）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fcd34d;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="468" y="170" width="308" height="56" as="geometry"/></mxCell><mxCell id="why1" value="误报淹没列表&lt;br&gt;用户打开一次就再也不看" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fcd34d;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="468" y="240" width="308" height="56" as="geometry"/></mxCell><mxCell id="why2" value="R4+R5 恰好 50 分&lt;br&gt;永远够不到 high/critical" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fcd34d;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="468" y="310" width="308" height="56" as="geometry"/></mxCell><mxCell id="why3" value="升级与通知通道&lt;br&gt;从未打开过一次" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fcd34d;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="468" y="380" width="308" height="56" as="geometry"/></mxCell><mxCell id="why4" value="无人处置 → 无人调参&lt;br&gt;闭环彻底死亡" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fcd34d;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="468" y="450" width="308" height="56" as="geometry"/></mxCell><mxCell id="ew0" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#d97706;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=PingFang SC;fontSize=11.5;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="why0" target="why1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ew1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#d97706;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=PingFang SC;fontSize=11.5;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="why1" target="why2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ew2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#d97706;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=PingFang SC;fontSize=11.5;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="why2" target="why3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ew3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#d97706;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=PingFang SC;fontSize=11.5;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="why3" target="why4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fix" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#6ee7b7;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="824" y="112" width="408" height="420" as="geometry"/></mxCell><mxCell id="fixt" value="&lt;b&gt;三步止血 N1–N3 · 1 小时完成&lt;/b&gt;&lt;br&gt;只改配置，不动代码" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0f172a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="840" y="122" width="376" height="40" as="geometry"/></mxCell><mxCell id="f1" value="&lt;b&gt;N1 · tunnel_keywords 精确化&lt;/b&gt;&lt;br&gt;移除泛匹配 stun → 精确模式：&lt;br&gt;stun.[a-z0-9-]+.(xyz|top|cc|tk|buzz)&lt;br&gt;只命中高风险 TLD 的打洞域名" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6ee7b7;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="840" y="172" width="376" height="88" as="geometry"/></mxCell><mxCell id="f2" value="&lt;b&gt;N2 · 默认白名单 8 条&lt;/b&gt;&lt;br&gt;*.miwifi.com · stun.chat.bilibili.com&lt;br&gt;*.heytapmobi.com · stun.l.google.com&lt;br&gt;…覆盖大厂/家电正常 P2P" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6ee7b7;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="840" y="272" width="376" height="88" as="geometry"/></mxCell><mxCell id="f3" value="&lt;b&gt;N3 · EasyTier 白名单&lt;/b&gt;&lt;br&gt;*.easytier.cn 是知情自架组网&lt;br&gt;应白名单而非告警" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6ee7b7;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="840" y="372" width="376" height="64" as="geometry"/></mxCell><mxCell id="f4" value="&lt;b&gt;规则试运行验证&lt;/b&gt;&lt;br&gt;POST /rules/test 回放历史窗口&lt;br&gt;改前改后同窗对比，不入库" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6ee7b7;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="840" y="448" width="376" height="70" as="geometry"/></mxCell><mxCell id="ef1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#059669;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=PingFang SC;fontSize=11.5;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f1" target="f2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ef2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#059669;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=PingFang SC;fontSize=11.5;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f2" target="f3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="res" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#a5b4fc;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="48" y="568" width="1184" height="120" as="geometry"/></mxCell><mxCell id="rest" value="&lt;b&gt;止血成效（2026-09-07 线上实测）&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#64748b;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="64" y="576" width="400" height="20" as="geometry"/></mxCell><mxCell id="r1" value="&lt;b&gt;日均告警 73.5 → 12 条&lt;/b&gt;&lt;br&gt;-84%，且全部聚焦&lt;br&gt;真可疑域名" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a5b4fc;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12.5;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="64" y="602" width="272" height="72" as="geometry"/></mxCell><mxCell id="r2" value="&lt;b&gt;有效告警率 12% → 50%+&lt;/b&gt;&lt;br&gt;当日 top 域名即&lt;br&gt;stun.225284.xyz（18 次）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a5b4fc;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12.5;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="352" y="602" width="272" height="72" as="geometry"/></mxCell><mxCell id="r3" value="&lt;b&gt;基线规模受控&lt;/b&gt;&lt;br&gt;22937 行稳定在&lt;br&gt;7 天量级滚动" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a5b4fc;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12.5;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="602" width="272" height="72" as="geometry"/></mxCell><mxCell id="r4" value="&lt;b&gt;Next：结构性修复&lt;/b&gt;&lt;br&gt;X1 基线清理挂载 · X2 延迟写入&lt;br&gt;X4 打分重构（R5 独立信号）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a5b4fc;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12.5;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="928" y="602" width="304" height="72" as="geometry"/></mxCell><mxCell id="ebig1" value="误报淹没" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#dc2626;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=PingFang SC;fontSize=11.5;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="bad2" target="why1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ebig2" value="止血" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#059669;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=PingFang SC;fontSize=11.5;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="why4" target="f3"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>