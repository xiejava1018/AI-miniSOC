<mxfile host="app.diagrams.net" version="24.7.7"><diagram id="behavior-arch" name="behavior-arch"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="AI-miniSOC 行为分析模块 · 总体架构" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=22;fontColor=#0f172a;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="32" y="20" width="1216" height="34" as="geometry"/></mxCell><mxCell id="st" value="数据自下而上：路由器日志 → 采集解析 → 双引擎（实时检测 + 每日画像）→ 业务库 → 前端消费；身份管道补上「IP → 人」的桥" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#64748b;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="32" y="54" width="1216" height="24" as="geometry"/></mxCell><mxCell id="ui" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf2f8;strokeColor=#f9a8d4;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="1200" height="64" as="geometry"/></mxCell><mxCell id="ui_t" value="消费层 · 前端「行为分析」菜单" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#64748b;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="56" y="102" width="260" height="20" as="geometry"/></mxCell><mxCell id="n_ui" value="异常事件 · 行为统计 · 行为日志 · 黑名单 · 规则配置 · 行为基线 · 行为画像 L1 群体概览 / L2 单 IP 详情（身份/行为/风险/关系/异常） · AI 研判 · MCP 工具" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f9a8d4;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="104" width="900" height="48" as="geometry"/></mxCell><mxCell id="db" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#fcd34d;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="186" width="1200" height="96" as="geometry"/></mxCell><mxCell id="db_t" value="PostgreSQL（SOC 业务库）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#64748b;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="56" y="194" width="320" height="20" as="geometry"/></mxCell><mxCell id="n_t1" value="soc_browsing_events&lt;br&gt;异常事件（含 rule_hits）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fcd34d;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=11.5;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="220" width="196" height="48" as="geometry"/></mxCell><mxCell id="n_t2" value="soc_browsing_baseline&lt;br&gt;IP×域名 7 天基线" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fcd34d;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=11.5;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="268" y="220" width="196" height="48" as="geometry"/></mxCell><mxCell id="n_t3" value="soc_browsing_blacklist&lt;br&gt;黑名单 + 威胁情报" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fcd34d;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=11.5;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="476" y="220" width="196" height="48" as="geometry"/></mxCell><mxCell id="n_t4" value="soc_behavior_profiles&lt;br&gt;画像快照（7 天滚动标签）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fcd34d;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=11.5;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="684" y="220" width="216" height="48" as="geometry"/></mxCell><mxCell id="n_t5" value="soc_identity_events&lt;br&gt;/ bindings 身份绑定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fcd34d;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=11.5;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="912" y="220" width="196" height="48" as="geometry"/></mxCell><mxCell id="e_ui1" value="REST /api/v1/browsing" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#db2777;strokeWidth=2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;fontFamily=PingFang SC;fontSize=11.5;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n_t1" target="n_ui"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_ui2" value="REST /api/v1/behavior-profile" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#db2777;strokeWidth=2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;fontFamily=PingFang SC;fontSize=11.5;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n_t4" target="n_ui"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eng_l" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#93c5fd;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="306" width="588" height="336" as="geometry"/></mxCell><mxCell id="eng_lt" value="&lt;b&gt;实时检测引擎 · browsing_detection&lt;/b&gt;&lt;br&gt;BrowsingDetectorScheduler（asyncio · 每 5 分钟一轮）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=14;fontColor=#0f172a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="56" y="316" width="540" height="44" as="geometry"/></mxCell><mxCell id="n_rules" value="&lt;b&gt;RuleEngine 六类规则&lt;/b&gt;&lt;hr&gt;R1 恶意域名命中 · 100&lt;br&gt;R2 突发高频访问 · 40&lt;br&gt;R3 基线偏离 · 20&lt;br&gt;R4 隧道/穿透工具 · 35&lt;br&gt;R5 凌晨活跃 · 15（IP 级）&lt;br&gt;R6 可疑域名特征 · 15" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#93c5fd;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12.5;fontColor=#0f172a;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="368" width="268" height="180" as="geometry"/></mxCell><mxCell id="n_score" value="&lt;b&gt;加权打分与抑制&lt;/b&gt;&lt;br&gt;score = Σ(命中权重) ≥ 50 触发&lt;br&gt;同 (ip,domain) 30 分钟抑制期" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#93c5fd;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12.5;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="348" y="368" width="268" height="84" as="geometry"/></mxCell><mxCell id="n_eventsvc" value="&lt;b&gt;EventService 事件闭环&lt;/b&gt;&lt;br&gt;落 soc_browsing_events&lt;br&gt;severity ≥ high → 升级事件 + WS 通知" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#93c5fd;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12.5;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="348" y="466" width="268" height="82" as="geometry"/></mxCell><mxCell id="e_r3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#2563eb;strokeWidth=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontFamily=PingFang SC;fontSize=11.5;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n_score" target="n_rules"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_r4" value="≥ 阈值" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#2563eb;strokeWidth=2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontFamily=PingFang SC;fontSize=11.5;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n_eventsvc" target="n_score"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_db1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#94a3b8;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=PingFang SC;fontSize=11.5;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n_eventsvc" target="n_t1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eng_r" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#c4b5fd;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="652" y="306" width="588" height="336" as="geometry"/></mxCell><mxCell id="eng_rt" value="&lt;b&gt;行为画像引擎 · behavior_profile&lt;/b&gt;&lt;br&gt;BehaviorProfileSnapshotJob（每日 02:00 · 水位回溯补缺口）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=14;fontColor=#0f172a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="668" y="316" width="540" height="44" as="geometry"/></mxCell><mxCell id="n_agg" value="&lt;b&gt;聚合与画像计算&lt;/b&gt;&lt;hr&gt;aggregator · 24h 曲线 / 7 时段 / 星期热力&lt;br&gt;classifier · 14 类兴趣 × ACT/SYS/AD 三层&lt;br&gt;tagger · 17 条标签规则（夜猫子/码农/下载机…）&lt;br&gt;traffic_type · 人 / 机器 / 混合判定&lt;br&gt;confidence · 数据量 + 截断惩罚" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c4b5fd;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0f172a;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="672" y="368" width="268" height="180" as="geometry"/></mxCell><mxCell id="n_snap" value="&lt;b&gt;快照落库（幂等 upsert）&lt;/b&gt;&lt;br&gt;soc_behavior_profiles&lt;br&gt;soc_behavior_domains（TOP 200）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c4b5fd;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12.5;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="960" y="368" width="268" height="84" as="geometry"/></mxCell><mxCell id="n_rolling" value="&lt;b&gt;滚动窗口口径&lt;/b&gt;&lt;br&gt;分布=当日 · 标签/兴趣=近 7 天&lt;br&gt;gap 占位防「假绿」· 180 天留存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c4b5fd;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12.5;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="960" y="466" width="268" height="82" as="geometry"/></mxCell><mxCell id="e_p2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#7c3aed;strokeWidth=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontFamily=PingFang SC;fontSize=11.5;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n_snap" target="n_agg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_p3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#7c3aed;strokeWidth=2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontFamily=PingFang SC;fontSize=11.5;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n_rolling" target="n_snap"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_db2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#94a3b8;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=PingFang SC;fontSize=11.5;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n_snap" target="n_t4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="col" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#5eead4;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="670" width="1200" height="118" as="geometry"/></mxCell><mxCell id="col_t" value="采集与解析层（后端 lifespan 后台任务）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#64748b;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="56" y="678" width="400" height="20" as="geometry"/></mxCell><mxCell id="n_lokiclient" value="&lt;b&gt;LokiClient&lt;/b&gt;&lt;br&gt;5 分钟轮询 · 分页拉取&lt;br&gt;硬上限 50 万条防静默截断" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5eead4;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="72" y="706" width="276" height="68" as="geometry"/></mxCell><mxCell id="n_parser" value="&lt;b&gt;LogParser&lt;/b&gt;&lt;br&gt;正则提取 ip / domain / apptype&lt;br&gt;秒级去重 · 内外网分离" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5eead4;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="400" y="706" width="276" height="68" as="geometry"/></mxCell><mxCell id="n_identity" value="&lt;b&gt;身份管道 identity.py（Phase 0）&lt;/b&gt;&lt;br&gt;OpenSearch 每日增量抽取 full_log 用户名&lt;br&gt;→ soc_identity_events / bindings（账号 ⇄ 设备双向绑定）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5eead4;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="728" y="706" width="480" height="68" as="geometry"/></mxCell><mxCell id="e_l2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#2563eb;strokeWidth=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontFamily=PingFang SC;fontSize=11.5;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n_parser" target="n_lokiclient"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_eng1" value="窗口记录" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#2563eb;strokeWidth=2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontFamily=PingFang SC;fontSize=11.5;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n_lokiclient" target="n_rules"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_eng2" value="按日拉取" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#7c3aed;strokeWidth=2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.85;entryY=1;entryDx=0;entryDy=0;fontFamily=PingFang SC;fontSize=11.5;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n_lokiclient" target="n_agg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_db3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#94a3b8;strokeWidth=2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontFamily=PingFang SC;fontSize=11.5;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n_identity" target="n_t5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="src" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="816" width="1200" height="128" as="geometry"/></mxCell><mxCell id="src_t" value="数据源层" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#64748b;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="56" y="824" width="300" height="20" as="geometry"/></mxCell><mxCell id="n_router" value="&lt;b&gt;TP-Link 路由器 TL-R479GP-AC&lt;/b&gt;&lt;br&gt;上网行为日志（访问网址 / 使用应用）&lt;br&gt;≈ 20 万条 / 天 · OTLP 推送" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#93c5fd;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="72" y="852" width="280" height="76" as="geometry"/></mxCell><mxCell id="n_loki" value="&lt;b&gt;Loki 日志聚合&lt;/b&gt;&lt;br&gt;{exporter=&quot;OTLP&quot;} · 仅保留 7 天&lt;br&gt;标签含 54 个内网 IP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#93c5fd;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="424" y="852" width="280" height="76" as="geometry"/></mxCell><mxCell id="n_os" value="&lt;b&gt;Wazuh → OpenSearch&lt;/b&gt;&lt;br&gt;wazuh-alerts-4.x-* · 128 万条原始告警&lt;br&gt;认证类规则 5715/5501/5763… full_log 含「谁登录了谁」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#93c5fd;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="776" y="852" width="432" height="76" as="geometry"/></mxCell><mxCell id="e_r1" value="syslog / OTLP" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#2563eb;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=PingFang SC;fontSize=11.5;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n_router" target="n_loki"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_l1" value="query_range" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#2563eb;strokeWidth=2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontFamily=PingFang SC;fontSize=11.5;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n_loki" target="n_lokiclient"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_l3" value="认证日志抽取" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#94a3b8;strokeWidth=2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontFamily=PingFang SC;fontSize=11.5;fontColor=#64748b;labelBackgroundColor=#