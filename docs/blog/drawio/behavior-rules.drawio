<mxfile host="app.diagrams.net" version="24.7.7"><diagram id="behavior-rules" name="behavior-rules"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="880"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="六规则加权打分引擎 · 从日志到处置闭环" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=22;fontColor=#0f172a;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="32" y="20" width="1216" height="34" as="geometry"/></mxCell><mxCell id="st" value="R1–R6 独立计分、加权求和、阈值分层；白名单前置过滤，30 分钟抑制防刷屏，高危自动升级并推送" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#64748b;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="32" y="54" width="1216" height="24" as="geometry"/></mxCell><mxCell id="i0" value="&lt;b&gt;窗口内记录&lt;/b&gt;&lt;br&gt;(ip, domain, ts)&lt;br&gt;≈ 700 条 / 5 分钟" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#93c5fd;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="48" y="120" width="220" height="84" as="geometry"/></mxCell><mxCell id="i1" value="&lt;b&gt;前置过滤&lt;/b&gt;&lt;br&gt;· 免检 IP（whitelist_ips）&lt;br&gt;· 域名白名单（exact + 通配）&lt;br&gt;· 公网 IP 剔除&lt;br&gt;· 按 (ip, domain) 聚合" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="48" y="260" width="220" height="110" as="geometry"/></mxCell><mxCell id="ei0" value="去重后" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#2563eb;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=PingFang SC;fontSize=11.5;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="i0" target="i1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="rules_c" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#93c5fd;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="112" width="640" height="344" as="geometry"/></mxCell><mxCell id="rules_ct" value="RuleEngine · 六类检测规则（可配置启停）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#64748b;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="316" y="120" width="400" height="20" as="geometry"/></mxCell><mxCell id="rule_R1" value="&lt;b&gt;R1 · 恶意域名命中　+100 分&lt;/b&gt;&lt;br&gt;黑名单精确/通配匹配&lt;br&gt;+ 威胁情报 1000 条" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#fca5a5;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="316" y="150" width="296" height="90" as="geometry"/></mxCell><mxCell id="rule_R2" value="&lt;b&gt;R2 · 突发高频访问　+40 分&lt;/b&gt;&lt;br&gt;窗口内同 IP 同域名&lt;br&gt;&amp;gt; 30 次（可调）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#fcd34d;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="624" y="150" width="296" height="90" as="geometry"/></mxCell><mxCell id="rule_R3" value="&lt;b&gt;R3 · 基线偏离　+20 分&lt;/b&gt;&lt;br&gt;7 天基线中&lt;br&gt;未见过的域名" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#5eead4;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="316" y="250" width="296" height="90" as="geometry"/></mxCell><mxCell id="rule_R4" value="&lt;b&gt;R4 · 隧道/穿透工具　+35 分&lt;/b&gt;&lt;br&gt;高风险 TLD 精确正则&lt;br&gt;stun.*.(xyz|top|cc|tk)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fdba74;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="624" y="250" width="296" height="90" as="geometry"/></mxCell><mxCell id="rule_R5" value="&lt;b&gt;R5 · 凌晨活跃　+15 分&lt;/b&gt;&lt;br&gt;02–05 点 IP 级加成&lt;br&gt;（叠加到该 IP 每条域名）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#a5b4fc;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="316" y="350" width="296" height="90" as="geometry"/></mxCell><mxCell id="rule_R6" value="&lt;b&gt;R6 · 可疑域名特征　+15 分&lt;/b&gt;&lt;br&gt;熵 ≥ 4.0 / 超长 /&lt;br&gt;纯 IP 直连（DGA）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#c4b5fd;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="624" y="350" width="296" height="90" as="geometry"/></mxCell><mxCell id="ei1" value="逐条评估" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#2563eb;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=PingFang SC;fontSize=11.5;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="i1" target="rule_R1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;score = Σ 命中权重&lt;/b&gt;&lt;br&gt;rule_hits 记录命中明细&lt;br&gt;聚合一条事件取最高分" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#93c5fd;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="992" y="150" width="240" height="96" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;严重度分层&lt;/b&gt;&lt;hr&gt;score ≥ 100 → critical&lt;br&gt;score ≥ 80 → high&lt;br&gt;score ≥ 50 → medium&lt;br&gt;其余 → low（不落地）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#93c5fd;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12.5;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="992" y="296" width="240" height="160" as="geometry"/></mxCell><mxCell id="es0" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#2563eb;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=PingFang SC;fontSize=11.5;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="rule_R2" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="es1" value="≥ 50 触发" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#2563eb;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=PingFang SC;fontSize=11.5;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="loop" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#6ee7b7;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="480" width="932" height="180" as="geometry"/></mxCell><mxCell id="loop_t" value="事件闭环（EventService + 前端处置）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=13;fontColor=#64748b;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="316" y="488" width="400" height="20" as="geometry"/></mxCell><mxCell id="l1" value="&lt;b&gt;事件入库&lt;/b&gt;&lt;br&gt;soc_browsing_events&lt;br&gt;状态 new → 处置流转&lt;br&gt;30 分钟抑制防刷屏" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6ee7b7;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="316" y="516" width="200" height="120" as="geometry"/></mxCell><mxCell id="l2" value="&lt;b&gt;高危升级&lt;/b&gt;&lt;br&gt;severity ≥ high&lt;br&gt;→ soc_incidents&lt;br&gt;安全事件统一管理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6ee7b7;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="544" y="516" width="200" height="120" as="geometry"/></mxCell><mxCell id="l3" value="&lt;b&gt;实时通知&lt;/b&gt;&lt;br&gt;站内通知 + WebSocket&lt;br&gt;仅 high/critical 推送&lt;br&gt;防骚扰" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6ee7b7;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="772" y="516" width="200" height="120" as="geometry"/></mxCell><mxCell id="l4" value="&lt;b&gt;人工处置&lt;/b&gt;&lt;br&gt;确认 / 误报 / 忽略&lt;br&gt;一键加白名单&lt;br&gt;AI 研判 / 原始日志回溯" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6ee7b7;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1000" y="516" width="216" height="120" as="geometry"/></mxCell><mxCell id="el1" value="落库" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#059669;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=PingFang SC;fontSize=11.5;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s2" target="l1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="el2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#059669;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=PingFang SC;fontSize=11.5;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l1" target="l2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="el3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#059669;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=PingFang SC;fontSize=11.5;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l2" target="l3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="el4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#059669;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=PingFang SC;fontSize=11.5;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l3" target="l4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="el5" value="误报 → 加白名单回流" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#94a3b8;strokeWidth=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontFamily=PingFang SC;fontSize=11.5;fontColor=#64748b;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="l4" target="i1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cfg" value="&lt;b&gt;全部可运营（soc_system_config · category=browsing_detection · 18 项）&lt;/b&gt;&lt;br&gt;score_threshold / burst_threshold / night 窗口 / tunnel_keywords 正则 / 白名单域名与 IP / 抑制期 / 通知人 ……改配置 60 秒内热生效，规则试运行 POST /rules/test 可回放任意时间窗口不入库" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=12.5;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="48" y="700" width="1184" height="84" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>